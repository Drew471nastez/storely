<template compat="shopify">
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- comment -%} Render guard: while this section is drawn or redrawn (a setting changed in the builder) its transitions are held, so nothing fades or slides into place. A redrawn section never replays its scroll animation. The section reveal plays once, and only for a section that starts below the first screen; the fade up of the blocks inside it (motion-element) follows the same rule, so the first screen and an edited section never fade in. {%- endcomment -%}
<style>
  #shopify-section-{{ section.id }}.sl-settling,
  #shopify-section-{{ section.id }}.sl-settling *,
  #shopify-section-{{ section.id }}.sl-settling *::before,
  #shopify-section-{{ section.id }}.sl-settling *::after {
    transition: none !important;
  }
  #shopify-section-{{ section.id }}.sl-still.scroll-trigger,
  #shopify-section-{{ section.id }}.sl-still .scroll-trigger {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
  #shopify-section-{{ section.id }}.sl-calm motion-element,
  #shopify-section-{{ section.id }}.sl-calm .scroll-trigger:not(.scroll-trigger--offscreen) {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' %}
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{%- endif %}
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var id = {{ section.id | json }};
    var el = document.getElementById('shopify-section-' + id);
    if (!el) return;
    var seen = window.__slSections || (window.__slSections = {});
    var redraw = seen[id] === 1;
    seen[id] = 1;
    if (redraw) el.classList.add('sl-still');
    if (redraw || el.getBoundingClientRect().top < (window.innerHeight || 0) || (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) el.classList.add('sl-calm');
    el.classList.add('sl-settling');
    var settle = function(){
      requestAnimationFrame(function(){
        requestAnimationFrame(function(){ el.classList.remove('sl-settling'); });
      });
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', settle, { once: true });
    } else {
      setTimeout(settle, 200);
    }
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' %}
    var anim = {{ settings.scroll_animation | json }};
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (redraw || reduce || el.getBoundingClientRect().top < (window.innerHeight || 0)) {
      el.classList.remove('scroll-trigger', anim, 'scroll-trigger--offscreen');
    } else {
      el.classList.add('scroll-trigger', anim);
    }
{%- endif %}
  })();
{% comment %}{% endcomment %}</script>
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Section background colour wiring. Painted on the section wrapper so
  the colour fills edge-to-edge regardless of inner section width.
{%- endcomment -%}
{%- if section.settings.section_bg != blank -%}
  <style>
    #shopify-section-{{ section.id }} {
      background-color: {{ section.settings.section_bg }};
    }
{% comment %}{% endcomment %}  </style>
{%- endif -%}
{%- comment -%}
  Remove default space between sections — zeroes this section's
  vertical margin when the toggle is on. Targets the wrapping
  `#shopify-section-{id}` so it works regardless of the section's
  root markup.
{%- endcomment -%}
{%- if section.settings.reset_spacing -%}
  <style>
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
{% comment %}{% endcomment %}  </style>
{%- endif -%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
{% comment %}{% endcomment %}</style>
{% assign heading_block = section.blocks | where: "type", "heading" | first %}
{% assign subheading_block = section.blocks | where: "type", "subheading" | first %}
<style>
  .body-parent-{{ section.id }} h1,
  .body-parent-{{ section.id }} h2,
  .body-parent-{{ section.id }} h3,
  .body-parent-{{ section.id }} h4,
  .body-parent-{{ section.id }} h5,
  .body-parent-{{ section.id }} .h0,
  .body-parent-{{ section.id }} .h1,
  .body-parent-{{ section.id }} .h2,
  .body-parent-{{ section.id }} .h3,
  .body-parent-{{ section.id }} .h4,
  .body-parent-{{ section.id }} .h5 {
    font-family: Inter, sans-serif;
    margin: 0;
  }

  .body-parent-{{ section.id }} a:empty,
  .body-parent-{{ section.id }} ul:empty,
  .body-parent-{{ section.id }} dl:empty,
  .body-parent-{{ section.id }} div:empty,
  .body-parent-{{ section.id }} section:empty,
  .body-parent-{{ section.id }} article:empty,
  .body-parent-{{ section.id }} p:empty,
  .body-parent-{{ section.id }} h1:empty,
  .body-parent-{{ section.id }} h2:empty,
  .body-parent-{{ section.id }} h3:empty,
  .body-parent-{{ section.id }} h4:empty,
  .body-parent-{{ section.id }} h5:empty,
  .body-parent-{{ section.id }} h6:empty {
    display: block;
  }
  .body-parent-{{ section.id }} *,
  .body-parent-{{ section.id }} *::before,
  .body-parent-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  .gallery-{{ section.id }} {
    max-width: {{ section.settings.section_width_desktop }}px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top_desktop }}px {{ section.settings.padding_right_desktop }}px {{ section.settings.padding_bottom_desktop }}px {{ section.settings.padding_left_desktop }}px;
  }

  .gallery-header-{{ section.id }} {
    padding: {{ section.settings.header_padding_top_desktop }}px {{ section.settings.header_padding_right_desktop }}px {{ section.settings.header_padding_bottom_desktop }}px {{ section.settings.header_padding_left_desktop }}px;
    text-align: center;
  }

  .gallery-heading-{{ section.id }} {
    font-size: {{ heading_block.settings.font_size_desktop }}px;
    color: {{ heading_block.settings.color }};
    font-weight: {{ heading_block.settings.font_weight }};
    margin: 0 0 {{ section.settings.heading_sub_gap }}px 0;
  }

  .gallery-subheading-{{ section.id }} {
    font-size: {{ subheading_block.settings.font_size_desktop }}px;
    color: {{ subheading_block.settings.color }};
    font-weight: {{ subheading_block.settings.font_weight }};
    margin: 0 0 {{ section.settings.sub_section_gap }}px 0;
  }

  .gallery-row-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat({{ section.settings.grid_desktop }}, 1fr);
    grid-gap: {{ section.settings.image_gap }}px;
  }

  .gallery-item-{{ section.id }} {
    height: {{ section.settings.image_height }}px;
  }

  .gallery-item-{{ section.id }} img {
    object-fit: cover;
    width: 100%;
    height: {{ section.settings.image_height }}px;
  }

  .gallery-link-{{ section.id }} {
    display: block;
  }

  @media (max-width: 768px) {
    .gallery-{{ section.id }} {
      max-width: {{ section.settings.section_width_mobile }}px;
      padding: {{ section.settings.padding_top_mobile }}px {{ section.settings.padding_right_mobile }}px {{ section.settings.padding_bottom_mobile }}px {{ section.settings.padding_left_mobile }}px;
    }

    .gallery-header-{{ section.id }} {
      padding: {{ section.settings.header_padding_top_mobile }}px {{ section.settings.header_padding_right_mobile }}px {{ section.settings.header_padding_bottom_mobile }}px {{ section.settings.header_padding_left_mobile }}px;
    }

    .gallery-heading-{{ section.id }} {
      font-size: {{ heading_block.settings.font_size_mobile }}px;
    }

    .gallery-subheading-{{ section.id }} {
      font-size: {{ subheading_block.settings.font_size_mobile }}px;
    }

    .gallery-row-{{ section.id }} {
      grid-template-columns: repeat({{ section.settings.grid_mobile }}, 1fr);
      grid-gap: {{ section.settings.image_gap }}px;
    }

    .gallery-item-{{ section.id }} {
      height: {{ section.settings.image_height_mobile }}px;
    }

    .gallery-item-{{ section.id }} img {
      height: {{ section.settings.image_height_mobile }}px;
    }
  }
{% comment %}{% endcomment %}</style>
<div class="body-parent-{{ section.id }}">
  <section class="gallery-{{ section.id }}">
    <div class="gallery-header-{{ section.id }}">
      {% if heading_block %}
        <h2 class="gallery-heading-{{ section.id }}">{{ heading_block.settings.text | escape }}</h2>
      {% endif %}
      {% if subheading_block %}
        <p class="gallery-subheading-{{ section.id }}">{{ subheading_block.settings.text | escape }}</p>
      {% endif %}
    </div>
    <div class="gallery-row-{{ section.id }}">
      {% for block in section.blocks %}
        {% if block.type == 'gallery_item' %}
          <div class="gallery-item-{{ section.id }}">
            {% if block.settings.enable_link and block.settings.link_url != blank %}
              <a href="{{ block.settings.link_url }}" class="gallery-link-{{ section.id }}">
            {% endif %}
              {% if block.settings.image %}
                <img
                  height="100%"
                  width="100%"
                  src="{{ block.settings.image | image_url: width: 4000 }}"
                  alt="{{ 'accessibility.gallery_image' | t }}"
                >
              {% elsif block.settings.image_url %}
                <img
                  height="100%"
                  width="100%"
                  src="{{ block.settings.image_url }}"
                  alt="{{ 'accessibility.gallery_image' | t }}"
                >
              {% else %}
                <img
                  height="100%"
                  width="100%"
                  src="https://2dbags.co/wp-content/uploads/revslider/lookbook1-demo_slider/placeholder.jpg"
                  alt="{{ 'accessibility.placeholder_image' | t }}"
                >
              {% endif %}
            {% if block.settings.enable_link and block.settings.link_url != blank %}
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </section>
</div>


</template>

<schema>
{
  "type": "gallerysimple4",
  "name": "Gallery Simple 4",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "heading_sub_gap",
      "label": "Gap between Heading and Subheading",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "sub_section_gap",
      "label": "Gap between Subheading and Gallery",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 19
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "Images Gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 7
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Header Padding (Desktop)"
    },
    {
      "type": "range",
      "id": "header_padding_top_desktop",
      "label": "Top Padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "header_padding_left_desktop",
      "label": "Left Padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "header_padding_right_desktop",
      "label": "Right Padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "header_padding_bottom_desktop",
      "label": "Bottom Padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "id": "hdr_11",
      "label": "Header Padding (Mobile)"
    },
    {
      "type": "range",
      "id": "header_padding_top_mobile",
      "label": "Top Padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "header_padding_left_mobile",
      "label": "Left Padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "header_padding_right_mobile",
      "label": "Right Padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "header_padding_bottom_mobile",
      "label": "Bottom Padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "id": "hdr_16",
      "label": "Section Width & Padding (Desktop)"
    },
    {
      "type": "number",
      "id": "section_width_desktop",
      "label": "Section Width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top Padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_left_desktop",
      "label": "Left Padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right_desktop",
      "label": "Right Padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom Padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "id": "hdr_22",
      "label": "Section Width & Padding (Mobile)"
    },
    {
      "type": "number",
      "id": "section_width_mobile",
      "label": "Section Width",
      "default": 360
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
