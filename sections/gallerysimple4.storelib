          "id": "font_size_desktop",
          "label": "Font Size",
          "min": 10,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 36
        },
        {
          "type": "header",
          "id": "hdr_4",
          "label": "Styling (Mobile)"
        },
        {
          "type": "range",
          "id": "font_size_mobile",
          "label": "Font Size",
          "min": 10,
          "max": 60,
          "step": 1,
          "unit": "px",
          "default": 28
        },
        {
          "type": "header",
          "id": "hdr_6",
          "label": "Color & Weight"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "default": "#000000"
        },
        {
          "type": "select",
          "id": "font_weight",
          "label": "Font Weight",
          "options": [
            {
              "value": "inherit",
              "label": "Inherit"
            },
            {
              "value": "normal",
              "label": "Normal"
            },
            {
              "value": "bold",
              "label": "Bold"
            },
            {
