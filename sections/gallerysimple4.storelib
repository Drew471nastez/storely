            },
            {
              "value": "200",
              "label": "200"
            },
            {
              "value": "300",
              "label": "300"
            },
            {
              "value": "400",
              "label": "400"
            },
            {
              "value": "500",
              "label": "500"
            },
            {
              "value": "600",
              "label": "600"
            },
            {
              "value": "700",
              "label": "700"
            },
            {
              "value": "800",
              "label": "800"
            },
            {
              "value": "900",
              "label": "900"
            }
          ],
          "default": "inherit"
        }
      ]
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Subheading",
          "default": "Discover our collection"
        },
        {
          "type": "header",
          "id": "hdr_2",
          "label": "Styling (Desktop)"
        },
        {
          "type": "range",
          "id": "font_size_desktop",
