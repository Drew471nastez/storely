      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "Left Padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 21
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "Right Padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 21
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "id": "hdr_28",
      "label": "Images Settings (Desktop)"
    },
    {
      "type": "range",
      "id": "grid_desktop",
      "label": "Number of Images",
      "min": 1,
      "max": 10,
      "default": 4
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image Height",
      "min": 50,
      "max": 600,
      "default": 300,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "header",
      "id": "hdr_31",
      "label": "Images Settings (Mobile)"
