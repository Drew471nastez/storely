          "label": "Enable Link",
          "default": false
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL",
          "info": "Only if link is enabled"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gallery Simple 4",
      "category": "Gallery",
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "text": "Gallery"
          }
        },
        {
          "type": "subheading",
          "settings": {
            "text": "Discover our collection"
          }
        },
        {
          "type": "gallery_item",
