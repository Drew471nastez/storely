      "label": "Number of Images",
      "min": 1,
      "max": 5,
      "default": 2
    },
    {
      "type": "range",
      "id": "image_height_mobile",
      "label": "Image Height",
      "min": 50,
      "max": 500,
      "default": 200,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background color",
      "info": "Background colour of the whole section. Set transparent to inherit the page.",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading",
          "default": "Gallery"
        },
        {
          "type": "header",
          "id": "hdr_2",
          "label": "Styling (Desktop)"
        },
        {
