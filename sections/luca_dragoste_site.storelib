.ld-price-note { width: 54%; margin: 30px 0 0; padding: 18px 20px; border: 1px solid var(--scheme-border); background: var(--scheme-background-secondary); color: var(--scheme-text-muted); font-size: 12px; }

.ld-about { padding: 120px 0; }
.ld-about__inner { display: grid; grid-template-columns: 190px minmax(0, 620px); gap: 52px; align-items: center; width: fit-content; max-width: calc(100% - 48px); margin-inline: auto; }
.ld-about img { width: 190px; height: 190px; object-fit: cover; }
.ld-about h2 { margin-bottom: 24px; }
.ld-about p { color: var(--scheme-text-muted); }

.ld-contact { min-height: 900px; }
.ld-contact__grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 110px; align-items: start; }
.ld-contact__heading { margin-bottom: 28px; color: var(--scheme-heading); font-family: var(--theme-font-heading, {{ theme.typography.heading }}), Georgia, "Times New Roman", serif; font-size: clamp(42px, 4vw, 58px); font-weight: 400; letter-spacing: -0.045em; line-height: 1; }
.ld-contact__heading p { margin: 0; }
.ld-contact p { color: var(--scheme-text-muted); }
.ld-contact a { color: var(--scheme-link); }
.ld-form { padding: 42px; border: 2px solid var(--scheme-heading); background: var(--scheme-background-secondary); }
.ld-form label { display: block; margin: 0 0 7px; color: var(--scheme-heading); font-size: 12px; font-weight: 700; }
.ld-form input, .ld-form select, .ld-form textarea { width: 100%; margin: 0 0 20px; padding: 13px 14px; border: 1px solid var(--scheme-border); border-radius: 0; background: var(--scheme-background); color: var(--scheme-text); font: inherit; }
.ld-form input, .ld-form select { height: 50px; }
.ld-form textarea { min-height: 155px; resize: vertical; }
.ld-form input:focus, .ld-form select:focus, .ld-form textarea:focus { outline: 2px solid var(--scheme-accent); outline-offset: 1px; }
.ld-form .ld-button { width: 100%; }

.ld-footer { border-top: 2px solid var(--scheme-heading); border-bottom: 5px solid var(--scheme-heading); background: var(--scheme-background); color: var(--scheme-text); }
.ld-footer__inner { display: flex; min-height: 160px; align-items: center; justify-content: space-between; gap: 40px; }
.ld-footer__inner > div { display: grid; color: var(--scheme-text-muted); font-size: 11px; line-height: 1.65; }
.ld-footer__inner strong { color: var(--scheme-heading); }
.ld-footer nav { display: flex; align-items: center; gap: 26px; color: var(--scheme-text-muted); font-size: 11px; }
.ld-footer a { text-decoration: none; }
.ld-footer a:hover { color: var(--scheme-heading); text-decoration: underline; }

@container (max-width: 900px) {
  .ld-shell { width: min(100% - 40px, 720px); }
  .ld-nav__links { gap: 14px; }
  .ld-hero__inner { grid-template-columns: 1fr; padding-top: 80px; }
  .ld-hero__visual { display: none; }
  .ld-services .ld-tab-panel { grid-template-columns: 1fr; }
  .ld-services .ld-tab-panel aside { border-top: 1px solid var(--scheme-border); border-left: 0; padding-left: 0; }
  .ld-split-heading, .ld-work__feature, .ld-two-col, .ld-contact__grid { grid-template-columns: 1fr; }
  .ld-work__feature { gap: 64px; }
  .ld-steps { grid-template-columns: 1fr; }
  .ld-steps article { min-height: 0; border-right: 0; border-bottom: 1px solid var(--scheme-border); }
  .ld-price-grid { grid-template-columns: 1fr; }
  .ld-price-card + .ld-price-card { border-top: 1px solid var(--scheme-border); border-left: 0; }
  .ld-price-note { width: 100%; }
}

@container (max-width: 620px) {
  .ld-shell { width: min(100% - 32px, 560px); }
  .ld-section { padding: 80px 0; }
  .ld-nav__inner { min-height: 64px; }
  .ld-nav__links a:not(.ld-nav__contact) { display: none; }
  .ld-hero, .ld-hero__inner { min-height: 720px; }
  .ld-hero__heading { font-size: clamp(48px, 15vw, 68px); }
  .ld-hero__lead { font-size: 17px; }
  .ld-inline-list { display: grid; }
  .ld h2 { font-size: 42px; }
  .ld-tabs__labels { gap: 20px; overflow-x: auto; }
  .ld-tabs__labels label { white-space: nowrap; }
  .ld-services .ld-tab-panel > div { padding-right: 0; }
  .ld-services h3, .ld-work__copy h3 { font-size: 40px; }
  .ld-work__feature { margin-top: 42px; }
  .ld-paper--sample { width: min(100%, 410px); }
  .ld-price-card { padding: 26px 20px; }
  .ld-about__inner { grid-template-columns: 96px 1fr; gap: 24px; }
  .ld-about img { width: 96px; height: 96px; }
  .ld-form { padding: 24px 18px; }
  .ld-footer__inner { align-items: flex-start; flex-direction: column; justify-content: center; }
  .ld-footer nav { flex-wrap: wrap; gap: 16px; }
}

@media (prefers-reduced-motion: reduce) {
  .ld { scroll-behavior: auto; }
}
</style>

