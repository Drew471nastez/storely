<template compat="shopify">
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- comment -%} Render guard: while this section is drawn or redrawn (a setting changed in the builder) its transitions are held, so nothing fades or slides into place. A redrawn section never replays its scroll animation. The section reveal plays once, and only for a section that starts below the first screen; the fade up of the blocks inside it (motion-element) follows the same rule, so the first screen and an edited section never fade in. {%- endcomment -%}
<style>
  #shopify-section-{{ section.id }}.sl-settling,
  #shopify-section-{{ section.id }}.sl-settling *,
  #shopify-section-{{ section.id }}.sl-settling *::before,
  #shopify-section-{{ section.id }}.sl-settling *::after {
    transition: none !important;
  }
  #shopify-section-{{ section.id }}.sl-still.scroll-trigger,
  #shopify-section-{{ section.id }}.sl-still .scroll-trigger {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
  #shopify-section-{{ section.id }}.sl-calm motion-element,
  #shopify-section-{{ section.id }}.sl-calm .scroll-trigger:not(.scroll-trigger--offscreen) {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' %}
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{%- endif %}
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var id = {{ section.id | json }};
    var el = document.getElementById('shopify-section-' + id);
    if (!el) return;
    var seen = window.__slSections || (window.__slSections = {});
    var redraw = seen[id] === 1;
    seen[id] = 1;
    if (redraw) el.classList.add('sl-still');
    if (redraw || el.getBoundingClientRect().top < (window.innerHeight || 0) || (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) el.classList.add('sl-calm');
    el.classList.add('sl-settling');
    var settle = function(){
      requestAnimationFrame(function(){
        requestAnimationFrame(function(){ el.classList.remove('sl-settling'); });
      });
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', settle, { once: true });
    } else {
      setTimeout(settle, 200);
    }
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' %}
    var anim = {{ settings.scroll_animation | json }};
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (redraw || reduce || el.getBoundingClientRect().top < (window.innerHeight || 0)) {
      el.classList.remove('scroll-trigger', anim, 'scroll-trigger--offscreen');
    } else {
      el.classList.add('scroll-trigger', anim);
    }
{%- endif %}
  })();
{% comment %}{% endcomment %}</script>
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Remove default space between sections — zeroes this section's
  vertical margin when the toggle is on. Targets the wrapping
  `#shopify-section-{id}` so it works regardless of the section's
  root markup.
{%- endcomment -%}
{%- if section.settings.reset_spacing -%}
  <style>
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
{% comment %}{% endcomment %}  </style>
{%- endif -%}
<style>
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation — prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; }
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
-%}
{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};--max-width: 50rem;
{%- endcapture -%}
<div
  class="section{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} page-default"
  style="{{ style | strip | strip_newlines }}"
>
  <div class="{{ section_width }}">
    <div class="page-title text-center">
      <h1>{{ page.title | escape }}</h1>
    </div>
    <div class="rte">
      {{ page.content }}
    </div>
  </div>
</div>



</template>

<schema>
{
  "type": "page-default",
  "name": "Page default",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "General"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretch width"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_4",
      "label": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    }
  ],
  "shopify": {
    "name": "t:sections.main-page.name",
    "settings": [
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "t:sections.all.section_width.label",
        "default": "container",
        "options": [
          {
            "value": "container",
            "label": "t:sections.all.section_width.container.label"
          },
          {
            "value": "fluid_container",
            "label": "t:sections.all.section_width.fluid_container.label"
          },
          {
            "value": "stretch_width",
            "label": "t:sections.all.section_width.stretch_width.label"
          },
          {
            "value": "full_width",
            "label": "t:sections.all.section_width.full_width.label"
          }
        ]
      },
      {
        "type": "header",
        "content": "Layout & Spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "t:sections.all.section_padding.top.label",
        "default": 0,
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "t:sections.all.section_padding.bottom.label",
        "default": 0,
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px"
      }
    ]
  }
}
</schema>
