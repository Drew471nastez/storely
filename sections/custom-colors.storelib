<template compat="shopify">
{%- comment -%} Render guard: while this section is drawn or redrawn (a setting changed in the builder) its transitions are held, so nothing fades or slides into place. A redrawn section never replays its scroll animation. The section reveal plays once, and only for a section that starts below the first screen. {%- endcomment -%}
<style>
  #shopify-section-{{ section.id }}.sl-settling,
  #shopify-section-{{ section.id }}.sl-settling *,
  #shopify-section-{{ section.id }}.sl-settling *::before,
  #shopify-section-{{ section.id }}.sl-settling *::after {
    transition: none !important;
  }
  #shopify-section-{{ section.id }}.sl-still.scroll-trigger,
  #shopify-section-{{ section.id }}.sl-still .scroll-trigger {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var id = {{ section.id | json }};
    var el = document.getElementById('shopify-section-' + id);
    if (!el) return;
    var seen = window.__slSections || (window.__slSections = {});
    var redraw = seen[id] === 1;
    seen[id] = 1;
    if (redraw) el.classList.add('sl-still');
    el.classList.add('sl-settling');
    var settle = function(){
      requestAnimationFrame(function(){
        requestAnimationFrame(function(){ el.classList.remove('sl-settling'); });
      });
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', settle, { once: true });
    } else {
      setTimeout(settle, 200);
    }
  })();
{% comment %}{% endcomment %}</script>
<style>
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation — prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; }
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{% capture colors %}
    <style>
        {%- for block in section.blocks -%}
          {% assign block_st = block.settings %}
            {%- if block_st.heading != blank -%}
             {% assign color_name = block_st.heading | downcase | replace: ' ', '-' %}
                .custom__color-swatches--{{ color_name }}{
                    {% if block_st.color_image == blank %}
                        background-color:{{ block_st.color_code }} !important;
                        background-image: initial !important;
                    {% else  %}
                        background:{{ block_st.color_code }} url({{ block_st.color_image | image_url: width: 80 }}) no-repeat 50% 50%/cover !important;
                    {% endif %}
                }
            {% endif %}
        {%- endfor -%} 
{% comment %}{% endcomment %}    </style>
{% endcapture %}
{{ colors | strip_newlines | remove: '  ' | remove: '	' }}


</template>

<schema>
{
  "type": "custom-colors",
  "name": "Custom colors",
  "settings": [],
  "blocks": [
    {
      "type": "color",
      "name": "Color",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "color",
          "id": "color_code",
          "label": "Color code"
        },
        {
          "type": "image_picker",
          "id": "color_image",
          "label": "Color image"
        }
      ]
    }
  ],
  "shopify": {
    "name": "t:sections.custom-colors.name",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:sections.custom-colors.settings.paragraph.content__1"
      },
      {
        "type": "paragraph",
        "content": "t:sections.custom-colors.settings.paragraph.content__2"
      }
    ],
    "blocks": [
      {
        "type": "color",
        "name": "t:sections.custom-colors.blocks.color.name",
        "settings": [
          {
            "type": "text",
            "id": "heading",
            "label": "t:sections.custom-colors.blocks.color.custom_color_name.label"
          },
          {
            "type": "color",
            "id": "color_code",
            "label": "t:sections.custom-colors.blocks.color.custom_color_code.label"
          },
          {
            "type": "image_picker",
            "id": "color_image",
            "label": "t:sections.custom-colors.blocks.color.custom_color_image.label"
          }
        ]
      }
    ]
  }
}
</schema>
