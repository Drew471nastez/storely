.ldhero li::before { content: ""; display: inline-block; width: 5px; height: 5px; margin-right: 9px; border-radius: 50%; background: var(--accent); vertical-align: 2px; }
.ldhero__actions { display: flex; align-items: center; gap: 22px; }
.ldhero__button { display: inline-flex; min-height: 48px; padding: 0 24px; align-items: center; justify-content: center; background: var(--accent); color: var(--paper); font-size: 14px; font-weight: 700; text-decoration: none; }
.ldhero__email { color: var(--fg); font-size: 14px; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
.ldhero__visual { position: relative; height: 430px; }
.paper { position: absolute; background: var(--paper); color: var(--ink); box-shadow: 0 12px 28px color-mix(in srgb, var(--ink) 16%, transparent); }
.paper a { color: var(--ink); font-size: 12px; font-weight: 700; text-decoration: underline; text-underline-offset: 2px; }
.paper__kicker { margin: 0 0 20px; font-size: 10px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
.paper__client { display: flex; margin: 0; align-items: center; gap: 9px; font-size: 12px; font-weight: 700; }
.paper__client img { width: 22px; height: 22px; border-radius: 50%; object-fit: cover; }
.paper__headline { margin: 50px 0 30px; font-family: "Bodoni 72", Didot, Georgia, serif; font-size: 31px; letter-spacing: -1.2px; line-height: .95; }
.paper--front { z-index: 2; top: 30px; left: 0; width: 235px; height: 360px; padding: 28px 26px; transform: rotate(-2deg); }
.paper--back { z-index: 1; top: 54px; right: 0; width: 215px; height: 310px; padding: 13px 12px 16px; transform: rotate(2.5deg); background: var(--soft); }
.doc { height: 250px; margin-bottom: 10px; padding: 24px 20px; background: var(--paper); }
.doc__dot { display: block; width: 13px; height: 13px; margin-bottom: 22px; border-radius: 50%; background: var(--ink); }
.doc p { margin: 0 0 8px; font-family: Georgia, serif; font-size: 13px; line-height: 1.1; }
.doc small { font-size: 8px; }
.doc__line { display: block; width: 80%; height: 2px; margin-top: 52px; background: var(--soft); }
.doc__line--short { width: 45%; margin-top: 6px; }
@container (max-width: 820px) { .ldhero { min-height: 720px; } .ldhero__in { grid-template-columns: 1fr; width: calc(100% - 32px); padding: 80px 0; } .ldhero__visual { display: none; } .ldhero h1 { font-size: clamp(50px, 13vw, 72px); } .ldhero__lead { font-size: 16px; } .ldhero ul { display: grid; font-size: 13px; } }
</style>

