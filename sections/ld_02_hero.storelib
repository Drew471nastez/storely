.paper__client span { display: inline-flex; width: 12px; height: 12px; align-items: center; justify-content: center; border-radius: 50%; background: var(--ink); color: var(--paper); font-family: Georgia, serif; font-size: 7px; font-style: italic; }
.paper__headline { margin: 28px 0 18px; font-family: "Bodoni 72", Didot, Georgia, serif; font-size: 17px; letter-spacing: -.7px; line-height: .95; }
.paper--front { z-index: 2; top: 21px; left: 2px; width: 120px; height: 192px; padding: 16px 14px; transform: rotate(-2deg); }
.paper--back { z-index: 1; top: 34px; right: 0; width: 110px; height: 164px; padding: 7px 6px 9px; transform: rotate(2.5deg); background: var(--soft); }
.doc { height: 133px; margin-bottom: 5px; padding: 13px 11px; background: var(--paper); }
.doc__dot { display: block; width: 7px; height: 7px; margin-bottom: 11px; border-radius: 50%; background: var(--ink); }
.doc p { margin: 0 0 4px; font-family: Georgia, serif; font-size: 7px; line-height: 1.1; }
.doc small { font-size: 3.5px; }
.doc__line { display: block; width: 80%; height: 1px; margin-top: 27px; background: var(--soft); }
.doc__line--short { width: 45%; margin-top: 3px; }
@container (max-width: 620px) { .ldhero { height: auto; min-height: 520px; } .ldhero__in { grid-template-columns: 1fr; padding: 62px 0; } .ldhero__visual { display: none; } .ldhero h1 { font-size: clamp(42px, 13vw, 54px); } .ldhero__lead { font-size: 12px; } .ldhero ul { display: grid; font-size: 8px; } }
