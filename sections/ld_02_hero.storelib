      </article>
    </div>
  </div>
</section>
</template>

<style scoped>
.ldhero { min-height: 680px; background: var(--bg); color: var(--fg); font-family: Arial, Helvetica, sans-serif; }
.ldhero__in { display: grid; grid-template-columns: 1.08fr .92fr; width: min(1180px, calc(100% - 64px)); min-height: 680px; margin: 0 auto; align-items: center; gap: 96px; }
.ldhero h1 { margin: 0 0 24px; color: var(--fg); font-family: "Bodoni 72", Didot, Georgia, serif; font-size: clamp(64px, 5.3vw, 82px); font-weight: 400; letter-spacing: -4px; line-height: .91; }
.ldhero__lead { max-width: 610px; margin: 0 0 24px; color: var(--muted); font-size: 16px; line-height: 1.55; }
