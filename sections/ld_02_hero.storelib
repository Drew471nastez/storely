.paper { position: absolute; background: var(--paper); color: var(--ink); box-shadow: 0 12px 28px color-mix(in srgb, var(--ink) 16%, transparent); }
.paper a { color: var(--ink); font-size: 6px; font-weight: 700; text-decoration: underline; text-underline-offset: 1px; }
.paper__kicker { margin: 0 0 11px; font-size: 5px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
