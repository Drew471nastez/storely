<template>
<section class="ldhero" data-scheme="{{ settings.color_scheme }}" style="--bg:{{ settings.background }};--fg:{{ settings.text }};--muted:{{ settings.muted }};--accent:{{ settings.accent }};--paper:{{ settings.paper }};--ink:{{ settings.ink }};--soft:{{ settings.paper_soft }};">
