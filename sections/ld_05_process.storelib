<template>
<section id="ld-process" class="ldp" data-scheme="{{ settings.color_scheme }}" style="--bg:{{ settings.background }};--ink:{{ settings.text }};--muted:{{ settings.muted }};--line:{{ settings.border }};--accent:{{ settings.accent }};">
  <div class="ldp__in">
    <h2>How each service works</h2>
    <div class="tabs">
      <input type="radio" name="{{ section.id }}-process" id="{{ section.id }}-ghost" checked>
      <input type="radio" name="{{ section.id }}-process" id="{{ section.id }}-seo">
