<template compat="shopify">
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- comment -%} Render guard: while this section is drawn or redrawn (a setting changed in the builder) its transitions are held, so nothing fades or slides into place. A redrawn section never replays its scroll animation. The section reveal plays once, and only for a section that starts below the first screen; the fade up of the blocks inside it (motion-element) follows the same rule, so the first screen and an edited section never fade in. {%- endcomment -%}
<style>
  #shopify-section-{{ section.id }}.sl-settling,
  #shopify-section-{{ section.id }}.sl-settling *,
  #shopify-section-{{ section.id }}.sl-settling *::before,
  #shopify-section-{{ section.id }}.sl-settling *::after {
    transition: none !important;
  }
  #shopify-section-{{ section.id }}.sl-still.scroll-trigger,
  #shopify-section-{{ section.id }}.sl-still .scroll-trigger {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
  #shopify-section-{{ section.id }}.sl-calm motion-element,
  #shopify-section-{{ section.id }}.sl-calm .scroll-trigger:not(.scroll-trigger--offscreen) {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
  #shopify-section-{{ section.id }}.sl-calm .lazy-loading-swiper-before {
    opacity: 1 !important;
    visibility: visible !important;
    transition: none !important;
  }
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' %}
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{%- endif %}
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var id = {{ section.id | json }};
    var el = document.getElementById('shopify-section-' + id);
    if (!el) return;
    var seen = window.__slSections || (window.__slSections = {});
    var redraw = seen[id] === 1;
    seen[id] = 1;
    if (redraw) el.classList.add('sl-still');
    if (redraw || el.getBoundingClientRect().top < (window.innerHeight || 0) || (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) el.classList.add('sl-calm');
    el.classList.add('sl-settling');
    var settle = function(){
      requestAnimationFrame(function(){
        requestAnimationFrame(function(){ el.classList.remove('sl-settling'); });
      });
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', settle, { once: true });
    } else {
      setTimeout(settle, 200);
    }
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' %}
    var anim = {{ settings.scroll_animation | json }};
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (redraw || reduce || el.getBoundingClientRect().top < (window.innerHeight || 0)) {
      el.classList.remove('scroll-trigger', anim, 'scroll-trigger--offscreen');
    } else {
      el.classList.add('scroll-trigger', anim);
    }
{%- endif %}
  })();
{% comment %}{% endcomment %}</script>
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<style>
  /* reset_spacing toggle — remove vertical margin between sections */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-top: 0 !important; margin-bottom: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<style>
  /* Theme font-weight inheritance — inherit theme weights by default; explicit rules still override */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
{% comment %}{% endcomment %}</style>
{%- comment -%}Section isolation — prevent CSS/JS bleed between sections{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { isolation: isolate; position: relative; }
{% comment %}{% endcomment %}</style>
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign infomation_meta = product.metafields.custom.information_product_tab
  assign reset_spacing = ''
  if st.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif
-%}
{%- if section.blocks.size > 0 -%}
  <div
    id="{{ section.id }}"
    class="section gradient {{ reset_spacing }} bls__product-tabs "
    data-section-type="tabs"
    data-section-id="{{ section.id }}"
  >
    <div class="{{ st.section_width }} section-full">
      <div class="product info detailed">
        <div class="product data items">
          <ul
            class="nav nav-tabs list-none text-center gap-30 gap-xl-60 p-0 flex  justify-content-start mb-big mt-0"
            style="--space-bottom: 40;--height: 2px;"
          >
            {%- for block in section.blocks %}
              {% liquid
                assign bk_st = block.settings
                assign hidden = ''
                if block.type == 'custom_tab' and bk_st.tab_content == 'content_custom'
                  assign hidden = 'hidden'
                  if infomation_meta.value.information_text != blank or infomation_meta.value.information_in_page != blank
                    assign hidden = ''
                  endif
                endif
              %}
              <li class="data {{ hidden }} item{% if forloop.first %} active{% endif %}">
                <a
                  class="is-nav-tabs heading-weight relative whitespace-nowrap heading-color py-15 inline-block border-animation"
                  href="#{{ block.id }}"
                  data-block-id="proTabs{{ block.id }}"
                  {%- if block.type == 'review' -%}
                    tab-review
                  {%- endif -%}
                  {%- if block.type == '@app' -%}
                    tab-review-app
                  {%- endif -%}
                >
                  {{- bk_st.title -}}
                  {%- if block.type == '@app' -%}
                    {{ 'products.product.review_app' | t }}
                  {%- endif -%}
                </a>
              </li>
            {%- endfor -%}
          </ul>
          <div class="tab-content">
            {%- for block in section.blocks %}
              {% assign bk_st = block.settings %}
              <div
                id="proTabs{{ block.id }}"
                class="tab-item transition{% if forloop.first  %} active{% endif %}"
              >
                <div
                  class="tab-panel"
                  {% if forloop.first %}
                    style="display: block;"
                  {% else %}
                    style="display: none;"
                  {% endif %}
                >
                  {%- case block.type -%}
                    {%- when '@app' -%}
                      {% render block %}
                    {%- when 'description' -%}
                      {{ product.description }}
                    {%- when 'review' -%}
                      <div id="shopify-product-reviews" data-id="{{ product.id }}">
                        {{ product.metafields.spr.reviews }}
                      </div>
                    {%- when 'custom_tab' -%}
                      {% assign tab_content = bk_st.tab_content %}
                      {%- case tab_content -%}
                        {%- when 'content' -%}
                          {% if bk_st.content_rich == blank %}
                            No content available.
                          {% else %}
                            {{ bk_st.content_rich }}
                          {% endif %}
                        {%- when 'content_page' -%}
                          {%- if bk_st.page != blank -%}
                            {{ pages[bk_st.page].content }}
                          {%- endif -%}
                        {% when 'content_custom' %}
                          {% if infomation_meta.value.information_text != blank %}
                            {{ infomation_meta.value.information_text }}
                          {% elsif infomation_meta.value.information_in_page != blank %}
                            {{ pages[infomation_meta.value.information_in_page].content }}
                          {% endif %}
                      {%- endcase -%}
                  {%- endcase -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

<script src="{{ 'product_tab.js' | asset_url }}" defer></script>


</template>

<schema>
{
  "type": "product-information-tab",
  "name": "Product information tab",
  "settings": [
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove default space between sections",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_2",
      "label": "General"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Container"
        },
        {
          "value": "fluid_container",
          "label": "Fluid container"
        },
        {
          "value": "stretch_width",
          "label": "Stretch width"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "header",
      "id": "hdr_4",
      "label": "Animation & Behavior"
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "info": "Animates the section into view using Theme settings → Animations.",
      "default": true
    },
    {
      "type": "header",
      "id": "hdr_6",
      "label": "Layout & Spacing"
    }
  ],
  "blocks": [
    {
      "type": "description",
      "name": "Description",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Section Header"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        }
      ],
      "limit": 1
    },
    {
      "type": "custom_tab",
      "name": "Custom tab",
      "settings": [
        {
          "type": "header",
          "id": "hdr_1",
          "label": "Section Header"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Custom tab"
        },
        {
          "type": "header",
          "id": "hdr_3",
          "label": "Content"
        },
        {
          "type": "richtext",
          "id": "content_rich",
          "label": "Content rich",
          "default": "<p>abd</p>"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Page"
        },
        {
          "type": "header",
          "id": "hdr_6",
          "label": "Advanced"
        },
        {
          "type": "select",
          "id": "tab_content",
          "label": "Tab content",
          "options": [
            {
              "value": "content",
              "label": "Content"
            },
            {
              "value": "content_page",
              "label": "Content page"
            },
            {
              "value": "content_custom",
              "label": "Content custom"
            }
          ]
        }
      ],
      "limit": 4
    }
  ],
  "shopify": {
    "name": "t:sections.product-information-tabs.name",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "checkbox",
        "id": "reset_spacing",
        "label": "Remove default space between sections",
        "default": true
      },
      {
        "type": "header",
        "content": "General"
      },
      {
        "type": "select",
        "id": "section_width",
        "label": "t:sections.all.section_width.label",
        "default": "container",
        "options": [
          {
            "value": "container",
            "label": "t:sections.all.section_width.container.label"
          },
          {
            "value": "fluid_container",
            "label": "t:sections.all.section_width.fluid_container.label"
          },
          {
            "value": "stretch_width",
            "label": "t:sections.all.section_width.stretch_width.label"
          },
          {
            "value": "full_width",
            "label": "t:sections.all.section_width.full_width.label"
          }
        ]
      },
      {
        "type": "header",
        "content": "Animation & Behavior"
      },
      {
        "type": "checkbox",
        "id": "reveal",
        "label": "Reveal on scroll",
        "info": "Animates the section into view using Theme settings → Animations.",
        "default": true
      },
      {
        "type": "header",
        "content": "Layout & Spacing"
      }
    ],
    "blocks": [
      {
        "type": "@app"
      },
      {
        "type": "description",
        "name": "t:sections.product-information-tabs.settings.description",
        "limit": 1,
        "settings": [
          {
            "type": "header",
            "content": "Section Header"
          },
          {
            "type": "text",
            "id": "title",
            "label": "t:sections.product-information-tabs.settings.description"
          }
        ]
      },
      {
        "type": "custom_tab",
        "name": "t:sections.product-information-tabs.blocks.custom_tab.name",
        "limit": 4,
        "settings": [
          {
            "type": "header",
            "content": "Section Header"
          },
          {
            "type": "text",
            "id": "title",
            "label": "t:sections.product-information-tabs.blocks.custom_tab.settings.title.label",
            "default": "Custom tab"
          },
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "richtext",
            "id": "content_rich",
            "label": "t:sections.product-information-tabs.blocks.custom_tab.settings.content.label",
            "default": "<p>abd</p>"
          },
          {
            "type": "page",
            "id": "page",
            "label": "t:sections.product-information-tabs.blocks.custom_tab.settings.page.label"
          },
          {
            "type": "header",
            "content": "Advanced"
          },
          {
            "type": "select",
            "id": "tab_content",
            "label": "t:sections.product-information-tabs.blocks.custom_tab.settings.tab_content.label",
            "options": [
              {
                "value": "content",
                "label": "t:sections.product-information-tabs.blocks.custom_tab.settings.tab_content.options__1.label"
              },
              {
                "value": "content_page",
                "label": "t:sections.product-information-tabs.blocks.custom_tab.settings.tab_content.options__2.label"
              },
              {
                "value": "content_custom",
                "label": "t:sections.product-information-tabs.blocks.custom_tab.settings.tab_content.options__3.label"
              }
            ]
          }
        ]
      }
    ]
  }
}
</schema>
