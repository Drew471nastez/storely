{# My section — yours. Everything below is a starting point. #}
<template>
<section class="my-section" style="--bg: {{ scheme.bg }}; --text: {{ scheme.paragraph }}; --heading: {{ scheme.heading }}; --accent: {{ scheme.accent }}; --pt: {{ settings.padding_top }}px; --pb: {{ settings.padding_bottom }}px;">
  <div class="my-section__in">
    {% if settings.eyebrow %}<p class="my-section__eyebrow">{{ settings.eyebrow }}</p>{% endif %}
    <h2 class="my-section__h">{{ settings.heading }}</h2>
    {% if settings.body %}<p class="my-section__body">{{ settings.body }}</p>{% endif %}
  </div>
</section>
</template>

<style>
.my-section {
  /* container-type lets the rules below ask how wide THIS section is,
     rather than how wide the browser window is. */
  container-type: inline-size;
  background: var(--bg);
  color: var(--text);
  padding: var(--pt) var(--theme-padding-x, 24px) var(--pb);
}
.my-section__in { max-width: 720px; margin: 0 auto; text-align: center; }
.my-section__eyebrow {
  margin: 0 0 12px;
  font-size: 12px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--accent);
}
.my-section__h {
  margin: 0;
  font-size: 28px; line-height: 1.15; font-weight: 700;
  color: var(--heading);
  /* A bare family name falls back to the browser's serif: give it a stack. */
  font-family: var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif;
}
.my-section__body { margin: 14px 0 0; font-size: 16px; line-height: 1.6; }

/* Tablet, then desktop. Phone is what the rules above already are. */
@container (min-width: 640px) { .my-section__h { font-size: 34px; } }
@container (min-width: 1024px) { .my-section__h { font-size: 40px; } }
</style>

<schema>
{
  "language_version": 1,
  "type": "my-section",
  "name": "My section",
  "category": "content",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "white"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "placeholder": "Short label above the heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "My section"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Text"
    },
    {
      "type": "header",
      "id": "hdr_spacing",
      "label": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "My section"
    }
  ]
}
</schema>
