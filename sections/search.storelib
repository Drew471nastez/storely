<template>
<section class="s" data-scheme="{{ settings.color_scheme }}" style="--s-bg: {{ scheme.bg }}; --s-text: {{ scheme.text }}; --s-heading: {{ scheme.heading }}; --s-para: {{ scheme.paragraph }}; --s-border: {{ scheme.border }}; --s-accent: {{ scheme.accent }}; --s-btn: {{ scheme.primary_btn_bg }}; --s-btn-text: {{ scheme.primary_btn_text }}; --s-radius: {{ theme.radius.medium }}px; --s-pt: {{ settings.padding_top }}px; --s-pb: {{ settings.padding_bottom }}px; --cols-d: {{ settings.columns.desktop }}; --cols-t: {{ settings.columns.tablet }}; --cols-m: {{ settings.columns.mobile }};">
  <div class="s__in s__in--{{ settings.max_width }}">
    {# The heading, then what was found, then the field: the page says what
       it is, answers the question that was asked, and offers to take a
       better one. Somebody who searched and got the wrong thing changes one
       word here rather than going back to the header to start again. #}
    {% if settings.heading %}<h1 class="s__h">{{ settings.heading }}</h1>{% endif %}
    {# The count is the list's own size and the words are the visitor's, so
       neither is a setting somebody could be asked to keep in step. With no
       query this is the whole shop, and the creator's own line goes here. #}
    {% if page.query %}
      {% if products.size == 0 %}
        <p class="s__sub">No results for "{{ page.query }}"</p>
      {% else %}
        <p class="s__sub">Showing results for "{{ page.query }}"</p>
      {% endif %}
    {% else %}
      {% if settings.intro %}<p class="s__sub">{{ settings.intro }}</p>{% endif %}
    {% endif %}

    <form class="find" action="/search" method="get" role="search">
      <input class="find__input" type="search" name="q" value="{{ page.query }}" placeholder="{{ settings.placeholder }}" aria-label="{{ settings.placeholder }}" autocomplete="off">
      <button class="find__go" type="submit">{{ settings.button_text }}</button>
    </form>

    {% if settings.source == 'picked' %}
      {% if blocks.size == 0 %}
        <p class="empty">{{ settings.empty_text }}</p>
      {% else %}
        <div class="grid">
          {% for block in blocks %}
          <article class="card card__wrap" data-block-id="{{ block.id }}">
            <div class="card__media" style="aspect-ratio: {{ settings.shape }};">
              {% if block.settings.image %}<img src="{{ block.settings.image | asset }}" alt="{{ block.settings.title }}" loading="lazy" decoding="async">{% endif %}
              {% if block.settings.tag %}<span class="tag">{{ block.settings.tag }}</span>{% endif %}
            </div>
            <h3 class="card__title">{{ block.settings.title }}</h3>
            {% if settings.show_price and block.settings.price %}
              <p class="card__price">{{ block.settings.price }}{% if block.settings.compare_price %}<s class="card__was">{{ block.settings.compare_price }}</s>{% endif %}</p>
            {% endif %}
            {% if block.settings.url %}<a class="card__link" href="{{ block.settings.url | url }}"><span class="sr">{{ block.settings.title }}</span></a>{% endif %}
          </article>
          {% endfor %}
        </div>
      {% endif %}
    {% else %}
    {% if products.size == 0 %}
      <p class="empty">{{ settings.empty_text }}</p>
    {% else %}
      <div class="grid">
        {% for block in products %}
        <article class="card card__wrap" data-block-id="{{ block.id }}">
          <div class="card__media" style="aspect-ratio: {{ settings.shape }};">
            {% if block.settings.image %}<img src="{{ block.settings.image | asset }}" alt="{{ block.settings.title }}" loading="lazy" decoding="async">{% endif %}
            {% if block.settings.tag %}<span class="tag">{{ block.settings.tag }}</span>{% endif %}
          </div>
          <h3 class="card__title">{{ block.settings.title }}</h3>
          {% if settings.show_price and block.settings.price %}
            <p class="card__price">{{ block.settings.price }}{% if block.settings.compare_price %}<s class="card__was">{{ block.settings.compare_price }}</s>{% endif %}</p>
          {% endif %}
          {% if block.settings.url %}<a class="card__link" href="{{ block.settings.url | url }}"><span class="sr">{{ block.settings.title }}</span></a>{% endif %}
        </article>
        {% endfor %}
      </div>
    {% endif %}
    {% endif %}
  </div>
</section>
</template>

<style scoped>
.s { container-type: inline-size; background: var(--s-bg); color: var(--s-text); }
.s__in {
  margin: 0 auto;
  padding: calc(var(--s-pt) * var(--theme-spacing-scale, 1)) var(--theme-padding-x, 24px) calc(var(--s-pb) * var(--theme-spacing-scale, 1));
}
.s__in--narrow { max-width: 720px; }
.s__in--medium { max-width: 960px; }
.s__in--wide { max-width: var(--theme-page-width, 1280px); }
.s__in--full { max-width: none; }

/* The field. One row on a phone as well, because a search button that wraps
   under its own input reads as two controls that are not related. */
.find { display: flex; gap: 8px; align-items: stretch; margin-top: 24px; max-width: 720px; }
.find__input {
  flex: 1 1 auto; min-width: 0;
  padding: 13px 16px; font: inherit; font-size: 16px; /* 16px: iOS zooms a smaller field on focus */
  color: var(--s-heading); background: var(--s-bg);
  border: 1px solid var(--s-border); border-radius: var(--s-radius);
  outline: none; transition: border-color 150ms ease;
}
.find__input::placeholder { color: var(--s-para); opacity: 0.6; }
.find__input:focus { border-color: var(--s-heading); }
/* Safari draws its own cancel control inside a `type=search`, in its own
   colours, and it lands on the border. */
.find__input::-webkit-search-decoration,
.find__input::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; }
.find__go {
  flex: 0 0 auto;
  padding: 13px 22px; font: inherit; font-size: 15px; font-weight: 600;
  color: var(--s-btn-text); background: var(--s-btn);
  border: 1px solid var(--s-btn); border-radius: var(--s-radius);
  cursor: pointer; transition: opacity 150ms ease;
}
.find__go:hover { opacity: 0.88; }

.s__h {
  margin: 0;
  font-size: var(--section-heading-size, 28px);
  line-height: var(--section-heading-line-height, 1.15);
  font-weight: var(--section-heading-weight, 700);
  color: var(--s-heading);
  letter-spacing: var(--section-heading-tracking, -0.01em);
  text-transform: var(--section-heading-transform, none);
  font-family: var(--theme-font-heading, {{ theme.typography.heading }}), ui-sans-serif, system-ui, sans-serif;
}
.s__sub { margin: 10px 0 0; font-size: var(--section-text-size, 16px); line-height: var(--section-text-line-height, 1.6); color: var(--s-para); }

.grid { display: grid; gap: 24px; margin-top: 32px; grid-template-columns: repeat(var(--cols-m), minmax(0, 1fr)); }
@container (min-width: 640px) { .grid { grid-template-columns: repeat(var(--cols-t), minmax(0, 1fr)); } }
@container (min-width: 900px) { .grid { grid-template-columns: repeat(var(--cols-d), minmax(0, 1fr)); } }
.card { display: flex; flex-direction: column; }
.card__wrap { position: relative; }
.card__media { position: relative; overflow: hidden; border-radius: var(--s-radius); background: var(--s-border); }
.card__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
.card__title { margin: 14px 0 0; font-size: 15px; font-weight: 600; color: var(--s-heading); }
.card__price { margin: 8px 0 0; display: flex; align-items: baseline; gap: 8px; font-size: 15px; font-weight: 600; color: var(--s-heading); }
.card__was { font-size: 13px; font-weight: 400; color: var(--s-para); opacity: 0.7; }
.card__link { position: absolute; inset: 0; }
.tag { position: absolute; top: 10px; left: 10px; padding: 4px 9px; border-radius: 999px; font-size: 11px; font-weight: 600; background: var(--s-btn); color: var(--s-btn-text); }
.empty { margin: 40px 0 0; text-align: center; font-size: 15px; color: var(--s-para); opacity: 0.7; }
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
</style>

<schema>
{
  "schema_version": 1,
  "type": "search",
  "name": "Search results",
  "category": "products",
  "description": "The search field and what it found. Shows the whole shop until somebody searches.",
  "version": "1.0.0",
  "icon": "search",
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "Products",
      "info": "The shop is what a search page shows. Picked is for a page that is really a curated list.",
      "default": "shop",
      "options": [
        { "label": "My shop", "value": "shop" },
        { "label": "The ones I pick", "value": "picked" }
      ]
    },
    {
      "type": "header",
      "id": "hdr_field",
      "label": "The field"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder",
      "default": "Search products"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button",
      "default": "Search"
    },
    {
      "type": "header",
      "id": "hdr_results",
      "label": "Results"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Search"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Before anybody has searched",
      "default": "Everything in the shop.",
      "info": "Replaced by the number of results once somebody does."
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "When nothing matches",
      "default": "Nothing matched. Try a shorter word.",
      "info": "Shown in place of the grid, with the field still above it."
    },
    {
      "type": "toggle",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "default": {
        "desktop": 3,
        "tablet": 2,
        "mobile": 1
      },
      "min": 1,
      "max": 4,
      "step": 1,
      "responsive": true
    },
    {
      "type": "select",
      "id": "shape",
      "label": "Image shape",
      "default": "1 / 1",
      "options": [
        { "label": "Square", "value": "1 / 1" },
        { "label": "Portrait", "value": "3 / 4" },
        { "label": "Landscape", "value": "4 / 3" }
      ]
    },
    {
      "type": "header",
      "id": "hdr_layout",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "max_width",
      "label": "Width",
      "default": "wide",
      "options": [
        { "label": "Narrow", "value": "narrow" },
        { "label": "Medium", "value": "medium" },
        { "label": "Wide", "value": "wide" },
        { "label": "Full", "value": "full" }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "default": 60,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "default": 60,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "white"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo", "default": "" },
        { "type": "text", "id": "title", "label": "Name", "default": "Product name" },
        { "type": "text", "id": "price", "label": "Price", "default": "$29" },
        { "type": "text", "id": "compare_price", "label": "Was", "default": "" },
        { "type": "text", "id": "tag", "label": "Corner label", "default": "" },
        { "type": "product_picker", "id": "url", "label": "Goes to", "default": "" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Search results",
      "settings": {
        "placeholder": "Search products",
        "button_text": "Search",
        "show_price": true,
        "max_width": "wide"
      }
    }
  ]
}
</schema>
