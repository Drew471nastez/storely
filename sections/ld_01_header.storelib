<template>
<header id="ld-top" class="ldh" data-scheme="{{ settings.color_scheme }}" style="--bg:{{ settings.background }};--fg:{{ settings.text }};--line:{{ settings.border }};--paper:{{ settings.contact_background }};--paper-text:{{ settings.contact_text }};--scroll-bg:{{ settings.scroll_background }};--scroll-text:{{ settings.scroll_text }};--scroll-line:{{ settings.scroll_border }};--accent:{{ settings.accent }};">
  <div class="ldh__in">
    <a class="ldh__brand" href="#ld-top">
      <img src="{{ settings.logo_url | asset }}" alt="{{ settings.logo_alt }}" width="18" height="18">
      <span>{{ settings.brand_name }}</span>
    </a>
    <nav class="ldh__nav" aria-label="Main navigation">
      <a href="#ld-services">Services</a>
      <a href="#ld-portfolio">Portfolio</a>
      <a href="#ld-process">How it works</a>
      <a href="#ld-pricing">Pricing</a>
      <a class="ldh__contact" href="#ld-contact">Contact</a>
    </nav>
  </div>
</header>
</template>

<style scoped>
.ldh { position: relative; z-index: 999; height: 72px; color: var(--fg); font-family: Arial, Helvetica, sans-serif; }
.ldh::before { content: ""; position: fixed; z-index: 998; top: 0; right: 0; left: 0; height: 71px; border-top: 2px solid var(--line); border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--bg) 96%, transparent); backdrop-filter: blur(16px) saturate(140%); -webkit-backdrop-filter: blur(16px) saturate(140%); animation: ldh-surface linear both; animation-timeline: scroll(root block); animation-range: 0 140px; }
.ldh__in { position: fixed; z-index: 999; top: 2px; right: 0; left: 0; display: flex; width: min(1180px, calc(100% - 64px)); height: 69px; margin: 0 auto; align-items: center; justify-content: space-between; color: var(--fg); animation: ldh-text linear both; animation-timeline: scroll(root block); animation-range: 0 140px; }
.ldh__brand { display: flex; align-items: center; gap: 10px; color: currentColor; font-size: 14px; font-weight: 700; text-decoration: none; }
.ldh__brand img { width: 32px; height: 32px; border: 1px solid var(--line); border-radius: 5px; object-fit: cover; }
.ldh__nav { display: flex; align-items: center; gap: 30px; }
.ldh__nav a { color: currentColor; font-size: 13px; text-decoration: none; }
.ldh__nav a:hover { text-decoration: underline; text-underline-offset: 2px; }
.ldh__nav .ldh__contact { padding: 12px 18px; background: var(--paper); color: var(--paper-text); animation: ldh-contact linear both; animation-timeline: scroll(root block); animation-range: 0 140px; }
@keyframes ldh-surface { from { border-color: var(--line); background-color: color-mix(in srgb, var(--bg) 96%, transparent); } to { border-color: var(--scroll-line); background-color: color-mix(in srgb, var(--scroll-bg) 96%, transparent); } }
@keyframes ldh-text { from { color: var(--fg); } to { color: var(--scroll-text); } }
@keyframes ldh-contact { from { background-color: var(--paper); color: var(--paper-text); } to { background-color: var(--accent); color: var(--paper); } }
@supports not (animation-timeline: scroll()) { .ldh::before { background: color-mix(in srgb, var(--bg) 92%, transparent); } }
@container (max-width: 720px) { .ldh__in { width: calc(100% - 32px); } .ldh__nav { gap: 12px; } .ldh__nav a:not(.ldh__contact) { display: none; } }
</style>

<schema>
{
  "schema_version": 1,
  "type": "ld_01_header",
  "name": "LD 01 — Header",
  "category": "custom",
  "version": "1.0.1",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "Luca Dragoste" },
    { "type": "url", "id": "logo_url", "label": "Logo URL", "default": "https://lucadragoste.ro/logo-ld.png" },
    { "type": "text", "id": "logo_alt", "label": "Logo alt text", "default": "Luca Dragoste LD logo" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Base colour scheme", "default": "black" },
    { "type": "color", "id": "background", "label": "Background", "default": "#15171D" },
    { "type": "color", "id": "text", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "border", "label": "Border", "default": "#4E5156" },
    { "type": "color", "id": "contact_background", "label": "Contact background", "default": "#FFFFFF" },
    { "type": "color", "id": "contact_text", "label": "Contact text", "default": "#15171D" },
    { "type": "color", "id": "scroll_background", "label": "Scrolled background", "default": "#FFFFFF" },
    { "type": "color", "id": "scroll_text", "label": "Scrolled text", "default": "#15171D" },
    { "type": "color", "id": "scroll_border", "label": "Scrolled border", "default": "#DFE0E4" },
    { "type": "color", "id": "accent", "label": "Scrolled button", "default": "#5381E5" }
  ],
  "presets": [{ "name": "LD 01 — Header" }]
}
</schema>
