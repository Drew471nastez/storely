<template compat="shopify">
{%- comment -%} Materia: connect this section to the theme-level animation settings (settings.scroll_animation / animation_duration / animation_delay). {%- endcomment -%}
{%- comment -%} Render guard: while this section is drawn or redrawn (a setting changed in the builder) its transitions are held, so nothing fades or slides into place. A redrawn section never replays its scroll animation. The section reveal plays once, and only for a section that starts below the first screen; the fade up of the blocks inside it (motion-element) follows the same rule, so the first screen and an edited section never fade in. {%- endcomment -%}
<style>
  #shopify-section-{{ section.id }}.sl-settling,
  #shopify-section-{{ section.id }}.sl-settling *,
  #shopify-section-{{ section.id }}.sl-settling *::before,
  #shopify-section-{{ section.id }}.sl-settling *::after {
    transition: none !important;
  }
  #shopify-section-{{ section.id }}.sl-still.scroll-trigger,
  #shopify-section-{{ section.id }}.sl-still .scroll-trigger {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
  #shopify-section-{{ section.id }}.sl-calm motion-element,
  #shopify-section-{{ section.id }}.sl-calm .scroll-trigger:not(.scroll-trigger--offscreen) {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
  #shopify-section-{{ section.id }}.sl-calm .lazy-loading-swiper-before {
    opacity: 1 !important;
    visibility: visible !important;
    transition: none !important;
  }
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' %}
  #shopify-section-{{ section.id }}.scroll-trigger {
    --animation-duration: {{ settings.animation_duration | default: 700 }}ms;
    --animation-delay: {{ settings.animation_delay | default: 0 }}ms;
  }
{%- endif %}
{% comment %}{% endcomment %}</style>
<script>
  (function(){
    var id = {{ section.id | json }};
    var el = document.getElementById('shopify-section-' + id);
    if (!el) return;
    var seen = window.__slSections || (window.__slSections = {});
    var redraw = seen[id] === 1;
    seen[id] = 1;
    if (redraw) el.classList.add('sl-still');
    if (redraw || el.getBoundingClientRect().top < (window.innerHeight || 0) || (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) el.classList.add('sl-calm');
    el.classList.add('sl-settling');
    var settle = function(){
      requestAnimationFrame(function(){
        requestAnimationFrame(function(){ el.classList.remove('sl-settling'); });
      });
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', settle, { once: true });
    } else {
      setTimeout(settle, 200);
    }
{%- if settings.scroll_animation != blank and settings.scroll_animation != 'none' %}
    var anim = {{ settings.scroll_animation | json }};
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (redraw || reduce || el.getBoundingClientRect().top < (window.innerHeight || 0)) {
      el.classList.remove('scroll-trigger', anim, 'scroll-trigger--offscreen');
    } else {
      el.classList.add('scroll-trigger', anim);
    }
{%- endif %}
  })();
{% comment %}{% endcomment %}</script>
<style data-rs-bulletproof>
  {%- if section.settings.reset_spacing -%}
    /* reset_spacing: bulletproof override of ALL section spacing mechanisms */
    #shopify-section-{{ section.id }},
    #shopify-section-{{ section.id }} > .section,
    #shopify-section-{{ section.id }} > section,
    #shopify-section-{{ section.id }} > div,
    #shopify-section-{{ section.id }} > div > .section {
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #shopify-section-{{ section.id }} + .shopify-section,
    #shopify-section-{{ section.id }} + section,
    .shopify-section + #shopify-section-{{ section.id }} {
      margin-top: 0 !important;
    }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
{%- liquid
  assign __ti_scroll_animation = settings.scroll_animation | default: 'none'
  assign __ti_reveal = section.settings.reveal
-%}
<style>
  /* Section isolation — prevent CSS/JS bleed between sections */
  #shopify-section-{{ section.id }} {
    isolation: isolate;
    position: relative;
  }
  /* Aggressive theme typography */
  :where(#shopify-section-{{ section.id }}) {
    font-family: var(--body-font, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :where(button, input, textarea, select, optgroup) {
    font-family: inherit;
  }
  /* Theme font-weight inheritance — sections inherit theme weights by default.
     Specific font-weight rules in section CSS still override these. */
  #shopify-section-{{ section.id }} {
    font-weight: var(--body-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-weight: var(--heading-weight, inherit);
  }
  :where(#shopify-section-{{ section.id }}) :is(h1, h2, h3, h4, h5, h6) {
    font-family: var(--heading-font, inherit);
  }
  /* Section margin sliders (mobile-first) */
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.section_margin_top_mobile | default: 0 }}px;
    margin-bottom: {{ section.settings.section_margin_bottom_mobile | default: 0 }}px;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ section.settings.section_margin_top_desktop | default: 0 }}px;
      margin-bottom: {{ section.settings.section_margin_bottom_desktop | default: 0 }}px;
    }
  }
  /* Section wrapper spans its parent's full width without breaking out of
     the editor preview. The section + first child span 100% so backgrounds
     reach edge-to-edge but the editor inspector outline stays inside the
     iframe viewport. */
  #shopify-section-{{ section.id }} {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    position: relative !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} > :where(div, section, header, footer, aside, main, article):first-child {
    max-width: none !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    box-sizing: border-box !important;
  }

  /* Section width — universal selector that works regardless of inner
     markup. Targets both:
       1) Theme container classes (.container/.fluid_container/etc.) — for
          sections that have an inner wrapper with that class
       2) The section's first-child div — for sections that don't have a
          named inner wrapper. The padding-inline sets the max content
          area while the wrapper itself stays 100% wide so any background
          stays edge-to-edge. */
  {%- case section.settings.section_width -%}
    {%- when 'container' -%}
      #shopify-section-{{ section.id }} .container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--page-width, 1300px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'fluid_container' -%}
      #shopify-section-{{ section.id }} .fluid_container,
      #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
        max-width: calc(var(--fluid-container-width, 1500px) + 3rem) !important;
        margin-inline: auto !important;
        box-sizing: border-box !important;
      }
    {%- when 'stretch_width' -%}
      /* Stretched: no max-width; tighter side padding handled below */
      @media (min-width: 1200px) {
        #shopify-section-{{ section.id }} .stretch_width,
        #shopify-section-{{ section.id }}:not(.no-section-width-wrap) > :is(div, section, header, footer, aside, main, article):first-child {
          padding-inline: 3rem;
        }
      }
    {%- when 'full_width' -%}
      /* full bleed — no constraints */
  {%- endcase -%}
  /* Reset spacing */
  {%- if section.settings.reset_spacing -%}
    #shopify-section-{{ section.id }} { margin-bottom: 0 !important; margin-top: 0 !important; }
    #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  {%- endif -%}
{% comment %}{% endcomment %}</style>
<!-- ti-theme:start -->
{%- comment -%}
  Materia Themes. Developed By Materia Themes.
{%- endcomment -%}
{%- liquid
  assign section_st = section.settings
  assign theme_st = settings
  assign section_width = section_st.section_width
  assign color_scheme = section_st.color_scheme.id | default: section_st.color_scheme
  assign slide_effect = 'slide'
  assign show_arrows = section_st.show_arrows
  assign show_arrows_mobile = section_st.show_arrows_mobile
  assign enable_custom_position = section_st.enable_custom_position
  assign desktop_horizontal_offset = section_st.desktop_horizontal_offset | default: 0
  assign text_align = section_st.text_align | default: 'center'
  assign letter_spacing = section_st.letter_spacing | default: 0
  assign border_position = section_st.border_position | default: 'bottom'
  assign border_width = section_st.border_width | default: 1
  assign border_color = section_st.border_color
  assign sticky_top = section_st.sticky_top
  assign custom_bg = section_st.custom_bg_color
  assign custom_text = section_st.custom_text_color
  assign custom_link = section_st.custom_link_color
  assign custom_arrow = section_st.custom_arrow_color
-%}
{%- if section.blocks.size > 0 -%}
  {%- style -%}
    #topbar-{{ section.id }} a { text-decoration-line: none; }
    #topbar-{{ section.id }} .topbar__section-inner { letter-spacing: {{ letter_spacing }}px; }
    .topbar-item .list-social__item a { width: 3rem; height: 3rem; }

    /* Per-slide responsive text variants — each slide can have a desktop
       and a mobile copy. Only one is visible per breakpoint. If the
       mobile field is left blank, the liquid falls back to the desktop
       text so the slide always has something to show. */
    #topbar-{{ section.id }} .topbar-text { display: inline; }
    #topbar-{{ section.id }} .topbar-text--sm { display: none; }
    #topbar-{{ section.id }} .topbar-text--lg { display: inline; }
    @media (max-width: 767.98px) {
      #topbar-{{ section.id }} .topbar-text--lg { display: none; }
      #topbar-{{ section.id }} .topbar-text--sm { display: inline; }
    }

    /* Custom color overrides — leave any setting blank to inherit the scheme. */
    {%- if custom_bg != blank -%}
      #topbar-{{ section.id }}.topbar { background: {{ custom_bg }} !important; }
      /* Arrow bars + fade veil match the custom background so they blend seamlessly. */
      #topbar-{{ section.id }} .topbar-slider .topbar-slider-arrow,
      #topbar-{{ section.id }} .topbar-slider-arrow {
        background: {{ custom_bg }} !important;
      }
      #topbar-{{ section.id }} slide-section.topbar-slider.has-arrows::before {
        background: linear-gradient(to right, {{ custom_bg }} 0%, {{ custom_bg }} 75%, rgba(0,0,0,0) 100%) !important;
      }
      #topbar-{{ section.id }} slide-section.topbar-slider.has-arrows::after {
        background: linear-gradient(to left, {{ custom_bg }} 0%, {{ custom_bg }} 75%, rgba(0,0,0,0) 100%) !important;
      }
    {%- endif -%}
    {%- if custom_text != blank -%}
      #topbar-{{ section.id }}, #topbar-{{ section.id }} .topbar__section-inner { color: {{ custom_text }} !important; }
    {%- endif -%}
    {%- if custom_link != blank -%}
      #topbar-{{ section.id }} a { color: {{ custom_link }} !important; }
    {%- endif -%}
    {%- if custom_arrow != blank -%}
      #topbar-{{ section.id }} .topbar-slider-arrow { color: {{ custom_arrow }} !important; }
    {%- endif -%}

    {%- unless show_arrows_mobile -%}
      @media (max-width: 767px) {
        #topbar-{{ section.id }} .topbar-slider-arrow { display: none !important; }
        #topbar-{{ section.id }} slide-section.topbar-slider.has-arrows { padding-left: 0.8rem; padding-right: 0.8rem; }
      }
    {%- endunless -%}

    {%- if enable_custom_position and desktop_horizontal_offset != 0 -%}
      /* Custom desktop horizontal offset — shifts the announcement messages
         left/right within the bar on desktop only. Mobile stays centered. */
      @media (min-width: 1025px) {
        #topbar-{{ section.id }} .topbar-item.text-slide {
          transform: translateX({{ desktop_horizontal_offset }}%);
          will-change: transform;
        }
      }
    {%- endif -%}

    /* Text slider — horizontal only, centered, arrows inline left/right of text. */
    #topbar-{{ section.id }} .text-slide {
      width: 100%;
      max-width: 60rem;
      flex: 0 0 auto;
      margin: 0 auto;
    }
    #topbar-{{ section.id }} slide-section.swiper {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      overflow: hidden;
    }
    #topbar-{{ section.id }} .swiper-wrapper {
      align-items: center;
    }
    #topbar-{{ section.id }} .swiper-slide {
      display: flex !important;
      align-items: center;
      text-align: {{ text_align }};
      justify-content: {% if text_align == 'left' %}flex-start{% elsif text_align == 'right' %}flex-end{% else %}center{% endif %};
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      transition: opacity .5s ease;
    }
    #topbar-{{ section.id }} .swiper-slide > * {
      width: 100%;
    }
    #topbar-{{ section.id }} .swiper:not([class*='initialized']) .swiper-wrapper .swiper-slide:not(:first-child) {
      opacity: 0;
    }
    #topbar-{{ section.id }} .swiper-fade .swiper-slide { transition-property: opacity, transform; }

    /* Inline arrows — absolutely pinned to the left/right edges of the slider.
       Arrows are FULL-HEIGHT solid bars whose background matches the topbar
       so any slide text passing underneath is masked. Every property that
       Swiper's own .swiper-button-prev/next defaults touch (top, margin-top,
       transform, width, height, background) is overridden with !important
       so we win the cascade and the arrow stays vertically centered, full
       height, and visible — never clipped at the top of the bar. */
    #topbar-{{ section.id }} slide-section.topbar-slider.has-arrows {
      padding-left: 7rem;
      padding-right: 7rem;
    }

    /* Soft fade veil — opaque gradient pseudo-elements layered ABOVE the
       slide content (z-index higher than any slide layer Swiper sets) so
       the slide head/tail entering an edge during a transition is masked
       by the topbar's own background BEFORE it reaches the arrow bar.
       The veil is FULLY opaque for ~75% of its width starting at the
       arrow's edge — only the last bit fades to transparent. Combined
       with padding that pushes slide content past the veil, this zone
       holds NO visible text bleed at any point in the slide cycle. */
    #topbar-{{ section.id }} slide-section.topbar-slider.has-arrows::before,
    #topbar-{{ section.id }} slide-section.topbar-slider.has-arrows::after {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      width: 3rem;
      pointer-events: none;
      z-index: 4;
    }
    #topbar-{{ section.id }} slide-section.topbar-slider.has-arrows::before {
      left: 4rem;
      background: linear-gradient(
        to right,
        var(--gradient-background, var(--color-background)) 0%,
        var(--gradient-background, var(--color-background)) 75%,
        rgba(0,0,0,0) 100%
      );
    }
    #topbar-{{ section.id }} slide-section.topbar-slider.has-arrows::after {
      right: 4rem;
      background: linear-gradient(
        to left,
        var(--gradient-background, var(--color-background)) 0%,
        var(--gradient-background, var(--color-background)) 75%,
        rgba(0,0,0,0) 100%
      );
    }
    @media (max-width: 767px) {
      #topbar-{{ section.id }} slide-section.topbar-slider.has-arrows {
        padding-left: 5.6rem;
        padding-right: 5.6rem;
      }
      #topbar-{{ section.id }} slide-section.topbar-slider.has-arrows::before { left: 3.2rem; width: 2.2rem; }
      #topbar-{{ section.id }} slide-section.topbar-slider.has-arrows::after { right: 3.2rem; width: 2.2rem; }
    }
    #topbar-{{ section.id }} .topbar-slider .topbar-slider-arrow,
    #topbar-{{ section.id }} .topbar-slider-arrow {
      position: absolute !important;
      top: 0 !important;
      bottom: 0 !important;
      margin: 0 !important;
      transform: none !important;
      width: 4rem !important;
      height: 100% !important;
      min-height: 100% !important;
      max-height: 100% !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      cursor: pointer;
      color: currentColor !important;
      opacity: 0.95;
      transition: opacity .2s ease, background-color .2s ease;
      background: var(--gradient-background, var(--color-background)) !important;
      border: 0 !important;
      padding: 0 !important;
      z-index: 3 !important;
      mix-blend-mode: normal !important;
      filter: none !important;
    }
    #topbar-{{ section.id }} .topbar-slider-arrow:hover { opacity: 1; }
    #topbar-{{ section.id }} .topbar-slider-arrow::after,
    #topbar-{{ section.id }} .topbar-slider-arrow::before { content: none !important; display: none !important; }
    #topbar-{{ section.id }} .topbar-slider-arrow svg {
      width: 16px !important;
      height: 16px !important;
      min-width: 16px;
      display: block;
      color: currentColor;
      stroke: currentColor;
      flex: 0 0 auto;
    }
    #topbar-{{ section.id }} .topbar-slider-arrow svg path {
      stroke: currentColor;
    }
    #topbar-{{ section.id }} .topbar-slider-arrow--prev { left: 0 !important; right: auto !important; }
    #topbar-{{ section.id }} .topbar-slider-arrow--next { right: 0 !important; left: auto !important; }
    @media (max-width: 767px) {
      #topbar-{{ section.id }} slide-section.topbar-slider.has-arrows {
        padding-left: 3.4rem;
        padding-right: 3.4rem;
      }
      #topbar-{{ section.id }} .topbar-slider .topbar-slider-arrow,
      #topbar-{{ section.id }} .topbar-slider-arrow { width: 3.2rem !important; }
      #topbar-{{ section.id }} .topbar-slider-arrow svg { width: 14px !important; height: 14px !important; }
    }

    {%- if border_position == 'top' or border_position == 'both' -%}
      #topbar-{{ section.id }} { border-top: {{ border_width }}px solid {% if border_color != blank %}{{ border_color }}{% else %}var(--color-border){% endif %}; }
    {%- endif -%}
    {%- if border_position == 'bottom' or border_position == 'both' -%}
      #topbar-{{ section.id }} { border-bottom: {{ border_width }}px solid {% if border_color != blank %}{{ border_color }}{% else %}var(--color-border){% endif %}; }
    {%- endif -%}
    {%- if sticky_top -%}
      #topbar-{{ section.id }} { position: sticky; top: 0; z-index: 12; }
    {%- endif -%}

    @media (min-width: 1024px) {
      #topbar-{{ section.id }} .text-slide {
        max-width: 48rem;
      }
    }
    @media (max-width: 1024px) {
      #topbar-{{ section.id }} .swiper-slide { justify-content: center; }
      #topbar-{{ section.id }} .text-slide { max-width: 100%; }
    }
  {%- endstyle -%}
  {%- capture style -%}
    --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};--swiper-navigation-color: var(--color-text);
  {%- endcapture -%}
  {%- liquid
    assign hidden_block = true
    for block in section.blocks
      assign block_st = block.settings
      if block_st.hidden_on_mobile == false
        assign hidden_block = false
        break
      endif
    endfor
  -%}
  <div
    id="topbar-{{ section.id }}"
    class="topbar gradient{% if section_st.padding_top < 30 %} pt-min{% endif %}{% if section_st.padding_bottom < 30 %} pb-min{% endif %} section remove_spacing color-{{ color_scheme }}{% if hidden_block == true %} hidden block-1025{% endif %}{% if section_st.show_separator_line and border_position == blank %} border-bottom{% endif %}{% if section_st.uppercase %} uppercase{% endif %}{% if section_st.show_mobile == blank %} hidden block-1025{% endif %}"
    style="{{ style | strip | strip_newlines }}"
  >
    <div class="{{ section_width }}">
      <div
        class="flex flex-wrap flex-md-nowrap gap justify-center justify-between-1025 align-center topbar__section-inner gap-10 gap-lg-25 fs-custom {{ section_st.font_weight }}"
        style="--font-size: {{ section_st.font_size }};"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign block_st = block.settings
          -%}
          {%- case block.type -%}
            {%- when 'store_information' -%}
              {% if theme_st.store_email != blank or theme_st.store_phone != blank %}
                <div class="topbar-item{% if block_st.hidden_on_mobile %} hidden flex-1025{% else %} flex{% endif %} gap-10">
                  {%- if block_st.show_phone and theme_st.store_phone != blank -%}
                    <a
                      class="no-underline"
                      href="tel:{{ theme_st.store_phone }}"
                      arial-label="{{ theme_st.store_phone }}"
                    >
                      <span>{{ theme_st.store_phone }}</span>
                    </a>
                  {% endif %}
                  {%- if block_st.show_email and theme_st.store_email != blank -%}
                    <a
                      class="no-underline"
                      href="mailto:{{ theme_st.store_email }}"
                      arial-label="{{ theme_st.store_email }}"
                    >
                      <span>{{ theme_st.store_email }}</span>
                    </a>
                  {% endif %}
                </div>
              {% endif %}
            {%- when 'socials' -%}
              {%- if settings.facebook != blank
                or settings.instagram != blank
                or settings.twitter != blank
                or settings.tiktok != blank
                or settings.youtube != blank
                or settings.pinterest != blank
                or settings.vimeo != blank
                or settings.linkedin != blank
                or settings.whatsapp != blank
                or settings.tumblr != blank
                or settings.snapchat != blank
              -%}
                <div class="topbar-item{% if block_st.hidden_on_mobile %} hidden block-1025{% endif %}">
                  {%- render 'social-icons' -%}
                </div>
              {% endif %}
            {%- when 'text_slider' -%}
              <div class="topbar-item text-slide{% if block_st.hidden_on_mobile %} hidden block-1025{% endif %}">
                <slide-section
                  class="swiper bls__swiper gap-0 lazy-loading-swiper-before topbar-slider{% if show_arrows %} has-arrows{% endif %}{% if slide_effect == 'fade' %} swiper-fade{% endif %}"
                  data-section-id="{{ section.id }}"
                  data-loop="true"
                  data-autoplay="true"
                  data-autoplaySpeed="{{ section_st.change_every }}"
                  data-speed="{{ section_st.transition_speed | default: 700 }}"
                  data-mobile="1"
                  data-tablet="1"
                  data-desktop="1"
                  data-direction="horizontal"
                  data-effect="{{ slide_effect }}"
                  data-spacing="0"
                  style="--color-dark: transparent;--swiper-navigation-color: currentColor; --col-gap: 0;"
                >
                  {%- if show_arrows -%}
                    <button
                      type="button"
                      class="swiper-arrow swiper-button-prev topbar-slider-arrow topbar-slider-arrow--prev"
                      aria-label="{{ 'accessibility.previous' | t }}"
                    >
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                        <path d="M9 3 4 7l5 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                  {%- endif -%}
                  <div class="swiper-wrapper">
                    {%- if block_st.text1 != blank or block_st.text1_mobile != blank -%}
                      <div class="swiper-slide lh-normal">
                        <div class="px-10 topbar-text-cell">
                          {%- if block_st.text1 != blank -%}
                            <span class="topbar-text topbar-text--lg">{{- block_st.text1 -}}</span>
                          {%- endif -%}
                          {%- assign mobile1 = block_st.text1_mobile | default: block_st.text1 -%}
                          {%- if mobile1 != blank -%}
                            <span class="topbar-text topbar-text--sm">{{- mobile1 -}}</span>
                          {%- endif -%}
                        </div>
                      </div>
                    {% endif %}
                    {%- if block_st.text2 != blank or block_st.text2_mobile != blank -%}
                      <div class="swiper-slide lh-normal">
                        <div class="px-10 topbar-text-cell">
                          {%- if block_st.text2 != blank -%}
                            <span class="topbar-text topbar-text--lg">{{- block_st.text2 -}}</span>
                          {%- endif -%}
                          {%- assign mobile2 = block_st.text2_mobile | default: block_st.text2 -%}
                          {%- if mobile2 != blank -%}
                            <span class="topbar-text topbar-text--sm">{{- mobile2 -}}</span>
                          {%- endif -%}
                        </div>
                      </div>
                    {% endif %}
                    {%- if block_st.text3 != blank or block_st.text3_mobile != blank -%}
                      <div class="swiper-slide lh-normal">
                        <div class="px-10 topbar-text-cell">
                          {%- if block_st.text3 != blank -%}
                            <span class="topbar-text topbar-text--lg">{{- block_st.text3 -}}</span>
                          {%- endif -%}
                          {%- assign mobile3 = block_st.text3_mobile | default: block_st.text3 -%}
                          {%- if mobile3 != blank -%}
                            <span class="topbar-text topbar-text--sm">{{- mobile3 -}}</span>
                          {%- endif -%}
                        </div>
                      </div>
                    {% endif %}
                  </div>
                  {%- if show_arrows -%}
                    <button
                      type="button"
                      class="swiper-arrow swiper-button-next topbar-slider-arrow topbar-slider-arrow--next"
                      aria-label="{{ 'accessibility.next' | t }}"
                    >
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                        <path d="m5 3 5 4-5 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                  {%- endif -%}
                </slide-section>
              </div>
            {%- when 'cur_lang' -%}
              <div class="lang__currency-desktop justify-content-center justity-md-unset topbar-item{% if block_st.hidden_on_mobile %} hidden flex-1025{% else %} flex{% endif %} flex-wrap gap-10 gap-lg-25 align-center row-gap-0">
                {%- if block_st.show_currency -%}
                  {%- render 'country-switcher' -%}
                {% endif %}
                {%- if block_st.show_language -%}
                  {%- render 'language-switcher' -%}
                {% endif %}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{% endif %}


</template>

